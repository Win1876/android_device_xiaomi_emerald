# System partitions
/system         erofs   /dev/block/by-name/system            flags=display=system;logical;slotselect
/system_ext     erofs   /dev/block/by-name/system_ext        flags=display=system_ext;logical;slotselect
/vendor         erofs   /dev/block/by-name/vendor            flags=display=vendor;logical;slotselect
/product        erofs   /dev/block/by-name/product           flags=display=product;logical;slotselect
/odm_dlkm       erofs   /dev/block/by-name/odm_dlkm         flags=display=odm_dlkm;logical;slotselect
/vendor_dlkm    erofs   /dev/block/by-name/vendor_dlkm      flags=display=vendor_dlkm;logical;slotselect
/mi_ext         erofs   /dev/block/by-name/mi_ext           flags=display=mi_ext;logical;slotselect

# A/B Boot Partitions
/boot          emmc   /dev/block/by-name/boot_a            flags=slotselect
/vendor_boot   emmc   /dev/block/by-name/vendor_boot_a     flags=slotselect

# Data and Cache
/data          f2fs   /dev/block/by-name/userdata          flags=display=data
/cache         ext4   /dev/block/by-name/rescue            flags=display=cache
/metadata      ext4   /dev/block/by-name/metadata          flags=display=metadata

# Persistent storage
/persistent    emmc   /dev/block/by-name/frp               flags=display=persistent
/nvram         emmc   /dev/block/by-name/nvram             flags=display=nvram
/proinfo       emmc   /dev/block/by-name/proinfo           flags=display=proinfo

# Other Important Partitions
/dtbo         emmc   /dev/block/by-name/dtbo              flags=display=dtbo
/vbmeta       emmc   /dev/block/by-name/vbmeta            flags=display=vbmeta
/vbmeta_vendor emmc /dev/block/by-name/vbmeta_vendor      flags=display=vbmeta_vendor;slotselect
/vbmeta_system emmc /dev/block/by-name/vbmeta_system      flags=display=vbmeta_system;slotselect

# Extra Mounts for Persist, Protect, and Logs
/mnt/vendor/protect_f  ext4 /dev/block/by-name/protect1    flags=display=protect_f
/mnt/vendor/protect_s  ext4 /dev/block/by-name/protect2    flags=display=protect_s
/mnt/vendor/nvdata     ext4 /dev/block/by-name/nvdata      flags=display=nvdata
/mnt/vendor/nvcfg      ext4 /dev/block/by-name/nvcfg       flags=display=nvcfg
/mnt/vendor/persist    ext4 /dev/block/by-name/persist     flags=display=persist

# USB and External Storage
auto          auto   /devices/platform/soc/11240000.mmc*  flags=display=auto
auto          vfat   /devices/platform/soc/mt_usb*        flags=display=auto
